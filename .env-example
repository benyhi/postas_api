####DATABASE/DJANGO########
# Base de datos para Docker/Postgres
POSTGRES_DB=postas_db
POSTGRES_USER=postas_user
POSTGRES_PASSWORD=postas_pass
POSTGRES_PORT=5432

# Dejar vacio para usar SQLite en desarrollo local
DATABASE_URL=
DB_PORT=5432

# API y frontend local
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_PATH=../postas/postas-front
POSTAS_PLATFORM_PORT=8001
POSTAS_PLATFORM_PATH=../postas_platform_api
NEXT_TELEMETRY_DISABLED=1
WATCHPACK_POLLING=true

# Django
SECRET_KEY=your-secret-key
ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api,tu-dominio-o-ip
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://tu-dominio-o-ip:3000

# Gunicorn/runtime
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60
####*DATABASE/DJANGO*########

####R2########
# Cloudflare R2
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=
R2_REGION=auto
R2_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.webp
R2_MAX_IMAGE_SIZE=5242880
####*R2*#######

####EMAIL########
# Providers
EMAIL_PROVIDER=resend
EMAIL_FALLBACK_PROVIDER=django
EMAIL_PROVIDER_FALLBACK_ENABLED=True

# Remitente y timeout
DEFAULT_FROM_EMAIL=POSTAS <notificaciones@tu-dominio-verificado.com>
EMAIL_TIMEOUT=20

# Resend, provider principal
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com
RESEND_COST_PER_1000_EMAILS=0.90

# Django, fallback actual
# Para pruebas 100% locales podes usar:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_SSL=False
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_COST_PER_1000_EMAILS=0.00

# Usada para reset password
FRONTEND_URL=http://localhost:3000
####*EMAIL*########

####PLATFORM BILLING########
# Fuente de verdad para planes, permisos y consumos
# Base URL local fuera de Docker; el compose la sobreescribe como http://postas_platform:8001
# No incluir /internal/v1
POSTAS_PLATFORM_API_URL=http://localhost:8001
# Debe coincidir con POSTAS_SERVICE_TOKEN en postas_platform_api
POSTAS_PLATFORM_SERVICE_TOKEN=
POSTAS_PLATFORM_SOURCE=postas_api
POSTAS_PLATFORM_TIMEOUT_SECONDS=10
POSTAS_PLATFORM_REQUIRE_TLS=False
ARCA_OUTBOX_POLL_SECONDS=5
ARCA_OUTBOX_BATCH_SIZE=20
POSTAS_PLATFORM_INTERNAL_REQUIRE_TLS=false
POSTAS_PLATFORM_ARCA_CREDENTIAL_MASTER_KEYS=
POSTAS_PLATFORM_ARCA_CREDENTIAL_ACTIVE_KEY_ID=
POSTAS_PLATFORM_ARCA_PRODUCTION_CALLS_ENABLED=false
POSTAS_PLATFORM_ARCA_TIMEOUT_SECONDS=30
POSTAS_PLATFORM_ARCA_WORKER_POLL_SECONDS=5
POSTAS_PLATFORM_ARCA_WORKER_BATCH_SIZE=20
POSTAS_PLATFORM_ARCA_CONSUMER_FINAL_IDENTIFICATION_THRESHOLD=10000000
# Defaults usados por el servicio postas_platform del docker-compose
POSTAS_PLATFORM_DATABASE_URL=postgresql+psycopg://postas_user:postas_pass@db:5432/postas_db
POSTAS_PLATFORM_REQUIRE_API_TOKEN=true
POSTAS_PLATFORM_ALLOWED_REQUEST_SOURCES=postas_api,postas_ai_api,localhost
# Para desarrollo Docker, "mock" evita depender de GOOGLE_API_KEY.
# Para usar Gemini real, cambiar a google_genai y configurar GOOGLE_API_KEY en postas_platform_api/.env.
POSTAS_PLATFORM_AI_PROVIDER=mock
POSTAS_PLATFORM_FALLBACK_AI_PROVIDER=
POSTAS_PLATFORM_MAX_AI_ATTEMPTS=1
POSTAS_PLATFORM_GOOGLE_MODEL=gemini-2.5-flash-lite
POSTAS_PLATFORM_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
POSTAS_PLATFORM_MAX_IMAGE_BYTES=10485760
POSTAS_PLATFORM_ACCEPTED_CONFIDENCE_THRESHOLD=0.85
POSTAS_PLATFORM_MINIMUM_CONFIDENCE_THRESHOLD=0.60
POSTAS_PLATFORM_INPUT_TOKEN_COST_PER_MILLION=0
POSTAS_PLATFORM_OUTPUT_TOKEN_COST_PER_MILLION=0
####*PLATFORM BILLING*########

####IA API########
# Document extractor / IA API
AI_EXTRACTOR_BASE_URL=http://localhost:8001/api/v1
AI_EXTRACTOR_TOKEN=
AI_EXTRACTOR_SOURCE=postas_api
AI_EXTRACTOR_TIMEOUT=90
DOCUMENT_EXTRACTOR_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png
DOCUMENT_EXTRACTOR_MAX_IMAGE_SIZE=5242880
DOCUMENT_EXTRACTOR_PRESIGNED_URL_TTL=600
DOCUMENT_EXTRACTOR_ACCEPTED_CONFIDENCE=0.85
DOCUMENT_EXTRACTOR_MIN_CONFIDENCE=0.60
####*IA API*########

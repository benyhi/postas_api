POSTGRES_DB=postas_db
POSTGRES_USER=postas_user
POSTGRES_PASSWORD=postas_pass
POSTGRES_PORT=5432
DATABASE_URL=postgres://postas_user:postas_pass@localhost:5432/postas_db
DB_PORT=5432
API_PORT=8000
FRONTEND_PORT=3000
FRONTEND_PATH=../postas/postas-front
NEXT_TELEMETRY_DISABLED=1
WATCHPACK_POLLING=true
SECRET_KEY=your-secret-key
ENV=development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api,tu-dominio-o-ip
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://tu-dominio-o-ip:3000
FRONTEND_URL=http://localhost:3000
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60

# Cloudflare R2
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=
R2_REGION=auto

# Email SMTP. Para pruebas 100% locales podes usar:
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=POSTAS <noreply@postas.app>
EMAIL_TIMEOUT=20

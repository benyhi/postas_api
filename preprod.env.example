# Copy this file to preprod.env. The real file is ignored by Git because it
# ends in .env. Values marked CHANGE_ME are development credentials for the
# preproduction simulation and must never be reused in production.

PREPROD_HOST=localhost
PREPROD_BIND_ADDRESS=127.0.0.1
PREPROD_HTTPS_PORT=8443

POSTAS_DB_NAME=postas_preprod
POSTAS_DB_USER=postas_preprod
POSTAS_DB_PASSWORD=CHANGE_ME_POSTAS_DB_PASSWORD
POSTAS_DATABASE_URL=postgresql://postas_preprod:CHANGE_ME_POSTAS_DB_PASSWORD@postas_db:5432/postas_preprod

PLATFORM_DB_NAME=postas_platform_preprod
PLATFORM_DB_USER=postas_platform_preprod
PLATFORM_DB_PASSWORD=CHANGE_ME_PLATFORM_DB_PASSWORD
PLATFORM_DATABASE_URL=postgresql+psycopg://postas_platform_preprod:CHANGE_ME_PLATFORM_DB_PASSWORD@platform_db:5432/postas_platform_preprod

DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_DJANGO_SECRET_KEY
POSTAS_PLATFORM_SERVICE_TOKEN=CHANGE_ME_SHARED_SERVICE_TOKEN
AI_EXTRACTOR_TOKEN=CHANGE_ME_AI_SERVICE_TOKEN
MERCADO_PAGO_WEBHOOK_SECRET=

DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443
FRONTEND_URL=https://localhost:3000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60
PLATFORM_WEB_CONCURRENCY=2

# Preproduction uses production-like processes and HTTPS. HSTS is intentionally
# short because the gateway uses Caddy local development CA.
SECURE_HSTS_SECONDS=300

CACHE_KEY_PREFIX=postas:preproduction
BILLING_ENTITLEMENT_ALLOW_TTL_SECONDS=60
BILLING_ENTITLEMENT_DENY_TTL_SECONDS=20

EMAIL_PROVIDER=django
EMAIL_FALLBACK_PROVIDER=django
EMAIL_PROVIDER_FALLBACK_ENABLED=false
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=POSTAS Preprod <noreply@localhost>
EMAIL_TIMEOUT=20

R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_URL=
R2_REGION=auto

POSTAS_PLATFORM_TIMEOUT_SECONDS=10
ARCA_OUTBOX_POLL_SECONDS=5
ARCA_OUTBOX_BATCH_SIZE=20
MERCADO_PAGO_WORKER_POLL_SECONDS=5
MERCADO_PAGO_WORKER_BATCH_SIZE=20
MERCADO_PAGO_WORKER_STALE_SECONDS=300
MERCADO_PAGO_WEBHOOK_SIGNATURE_TOLERANCE_SECONDS=300

POSTAS_PLATFORM_ARCA_CREDENTIAL_MASTER_KEYS=
POSTAS_PLATFORM_ARCA_CREDENTIAL_ACTIVE_KEY_ID=
POSTAS_PLATFORM_ARCA_PRODUCTION_CALLS_ENABLED=false
POSTAS_PLATFORM_ARCA_TIMEOUT_SECONDS=30
POSTAS_PLATFORM_ARCA_WORKER_POLL_SECONDS=5
POSTAS_PLATFORM_ARCA_WORKER_BATCH_SIZE=20
POSTAS_PLATFORM_ARCA_CONSUMER_FINAL_IDENTIFICATION_THRESHOLD=10000000

POSTAS_PLATFORM_MERCADO_PAGO_CLIENT_ID=
POSTAS_PLATFORM_MERCADO_PAGO_CLIENT_SECRET=
POSTAS_PLATFORM_MERCADO_PAGO_REDIRECT_URI=https://localhost:8443/api/v1/mercado-pago/oauth/callback
POSTAS_PLATFORM_MERCADO_PAGO_PLATFORM_ID=
POSTAS_PLATFORM_MERCADO_PAGO_APPLICATION_ID=
POSTAS_PLATFORM_MERCADO_PAGO_INTEGRATOR_ID=
POSTAS_PLATFORM_MERCADO_PAGO_CONNECT_TIMEOUT_SECONDS=5
POSTAS_PLATFORM_MERCADO_PAGO_READ_TIMEOUT_SECONDS=20
POSTAS_PLATFORM_MERCADO_PAGO_WRITE_TIMEOUT_SECONDS=20
POSTAS_PLATFORM_MERCADO_PAGO_OAUTH_STATE_TTL_SECONDS=600
POSTAS_PLATFORM_MERCADO_PAGO_REFRESH_SKEW_SECONDS=300
POSTAS_PLATFORM_MERCADO_PAGO_CREDENTIAL_MASTER_KEYS=
POSTAS_PLATFORM_MERCADO_PAGO_CREDENTIAL_ACTIVE_KEY_ID=

# Use mock until a development provider key is intentionally configured.
POSTAS_PLATFORM_AI_PROVIDER=mock
POSTAS_PLATFORM_FALLBACK_AI_PROVIDER=
POSTAS_PLATFORM_MAX_AI_ATTEMPTS=1
POSTAS_PLATFORM_GOOGLE_API_KEY=
POSTAS_PLATFORM_GOOGLE_MODEL=gemini-2.5-flash-lite
POSTAS_PLATFORM_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=15
POSTAS_PLATFORM_MAX_IMAGE_BYTES=10485760
POSTAS_PLATFORM_ACCEPTED_CONFIDENCE_THRESHOLD=0.85
POSTAS_PLATFORM_MINIMUM_CONFIDENCE_THRESHOLD=0.60
POSTAS_PLATFORM_INPUT_TOKEN_COST_PER_MILLION=0
POSTAS_PLATFORM_OUTPUT_TOKEN_COST_PER_MILLION=0
